@model Tp3.ViewModels.MembershipViewModel

@{
    ViewData["Title"] = "Membership Details";
}

<h1>Membership Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SignupFee)</dt>
        <dd class="col-sm-10">$@Model.SignupFee</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DurationInMonths)</dt>
        <dd class="col-sm-10">@Model.DurationInMonths months</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DiscountRate)</dt>
        <dd class="col-sm-10">@Model.DiscountRate%</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
