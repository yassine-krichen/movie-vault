@model Tp3.ViewModels.GenreViewModel

@{
    ViewData["Title"] = "Delete Genre";
}

<h1>Delete Genre</h1>

<h3>Are you sure you want to delete this genre?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.GenreName)</dt>
        <dd class="col-sm-10">@Model.GenreName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
