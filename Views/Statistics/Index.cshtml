@model Tp3.ViewModels.StatisticsViewModel

@{
    ViewData["Title"] = "Statistics";
}

<div class="container">
    <h1 class="mb-4">Statistics & Reports</h1>

    <div class="row">
        <!-- 1. Available Action Movies -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">1. Available Action Movies (Stock > 0)</h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableActionMovies.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var movie in Model.AvailableActionMovies)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @movie.Name
                                    <span class="badge bg-success rounded-pill">Stock: @movie.Stock</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No available action movies found.</p>
                    }
                </div>
            </div>
        </div>

        <!-- 2. Movies Ordered by Date & Name -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="card-title mb-0">2. Movies Ordered by Date & Name</h5>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    <ul class="list-group list-group-flush">
                        @foreach (var movie in Model.MoviesOrderedByDateAndName)
                        {
                            <li class="list-group-item">
                                <strong>@movie.Name</strong><br />
                                <small class="text-muted">Added: @(movie.DateAjoutMovie?.ToShortDateString() ?? "N/A")</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 3. Total Movie Count -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">3. Total Movies</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <h1 class="display-1">@Model.TotalMovieCount</h1>
                </div>
            </div>
        </div>

        <!-- 4. Subscribed Customers with Discount > 10% -->
        <div class="col-md-8 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">4. VIP Newsletter Subscribers (>10% Discount)</h5>
                </div>
                <div class="card-body">
                    @if (Model.SubscribedCustomersWithDiscount.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Membership</th>
                                        <th>Discount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in Model.SubscribedCustomersWithDiscount)
                                    {
                                        <tr>
                                            <td>@customer.Name</td>
                                            <td>@(customer.Membership?.DurationInMonths + " months" ?? "N/A")</td>
                                            <td>@(customer.Membership?.DiscountRate + "%" ?? "0%")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No matching customers found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 5. Movies with Genres (Join) -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">5. Movie - Genre List (Join)</h5>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Movie Title</th>
                                <th>Genre Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MoviesWithGenres)
                            {
                                <tr>
                                    <td>@item.MovieTitle</td>
                                    <td>@item.GenreName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 6. Top 3 Popular Genres -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">6. Top 3 Popular Genres</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopPopularGenres.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var genre in Model.TopPopularGenres)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @genre.GenreName
                                    <span class="badge bg-primary rounded-pill">@genre.Movies.Count movies</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No genres found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
